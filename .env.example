# 根目录单实例编排用（docker-compose.yml）
#   cp .env.example .env
# 密钥以此文件为准；应用通过 DATABASE_* / JWT_SECRET 注入，不再依赖镜像内 yaml 明文。

# ---- 应用 ----
APP_PORT=8888
INSTANCE_ID=app

# ---- MySQL 容器 + 应用 DATABASE_*（同一套账号）----
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=go_admin
MYSQL_USER=go_user
MYSQL_PASSWORD=go_user123

# ---- JWT ----
JWT_SECRET=change_me_jwt_secret_for_prod

# ---- Redis（无密码可留空）----
REDIS_PASSWORD=
