# 多实例编排用（conf/common/docker-compose.yml）
#   cp conf/common/.env.example conf/common/.env
#
# 密钥以此文件为唯一来源：
#   MySQL 容器 ← MYSQL_*
#   应用进程 ← DATABASE_* / JWT_SECRET / REDIS_PASSWORD（compose 已映射）

# ---- 应用 ----
APP_PORT=8888

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=go_admin
MYSQL_USER=go_user
MYSQL_PASSWORD=go_user123

# ---- JWT ----
JWT_SECRET=change_me_jwt_secret_for_ha

# ---- Redis（无密码可留空）----
REDIS_PASSWORD=

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---- 宿主机端口（默认仅绑 127.0.0.1）----
MYSQL_HOST_BIND=127.0.0.1
MYSQL_HOST_PORT=3306
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
JAEGER_UI_BIND=127.0.0.1
JAEGER_UI_PORT=16686
OTEL_GRPC_HOST_PORT=43170
OTEL_HTTP_HOST_PORT=43180
# Collector 浏览器探活（不是 43180；43180 是 OTLP 上报口）
OTEL_HEALTH_HOST_BIND=127.0.0.1
OTEL_HEALTH_HOST_PORT=13133
OTEL_ZPAGES_HOST_BIND=127.0.0.1
OTEL_ZPAGES_HOST_PORT=55679
PROMETHEUS_HOST_BIND=127.0.0.1
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_BIND=127.0.0.1
GRAFANA_HOST_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
